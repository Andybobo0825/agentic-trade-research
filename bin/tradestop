#!/usr/bin/env sh
PRG="$0"
while [ -h "$PRG" ]; do
  LINK="$(ls -ld -- "$PRG")"
  LINK="${LINK#* -> }"
  case "$LINK" in
    /*) PRG="$LINK" ;;
    *) PRG="$(dirname -- "$PRG")/$LINK" ;;
  esac
done
DIR="$(CDPATH= cd -- "$(dirname -- "$PRG")/.." && pwd)"
cd "$DIR" || exit 1
exec node src/tradstop.js "$@"
