# Optional US/global provider. Required only for Financial Datasets-backed US commands.
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key
FINANCIAL_DATASETS_BASE_URL=https://api.financialdatasets.ai

# Optional Taiwan free-data provider token. FinMind free API works without a token at a lower rate limit;
# registering a free account and adding token raises the documented free quota.
FINMIND_API_TOKEN=your-finmind-token
FINMIND_BASE_URL=https://api.finmindtrade.com

# Optional official Taiwan OpenAPI base URL overrides, useful for tests/proxies.
TWSE_OPENAPI_BASE_URL=https://openapi.twse.com.tw/v1
TPEX_OPENAPI_BASE_URL=https://www.tpex.org.tw/openapi/v1

# Fugle realtime/intraday Taiwan market data. Required only for fugle-* commands.
# Apply/manage the key in Fugle Developer after registering/logging in.
FUGLE_API_KEY=
FUGLE_MARKETDATA_BASE_URL=https://api.fugle.tw/marketdata/v1.0/stock


# LINE Messaging API bridge (optional; local webhook server + Cloudflare Tunnel required)
# Create/enable a LINE Official Account Messaging API channel, then paste these values from LINE Developers.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Friends who add the LINE Official Account are auto-authorized into this local whitelist by default.
LINE_BRIDGE_AUTO_AUTHORIZE_FRIENDS=true
LINE_BRIDGE_AUTHORIZED_USER_IDS_FILE=.omx/line-bridge/authorized-users.json
# Optional legacy/manual seed list. Usually leave empty; auto-authorized users persist in the whitelist file above.
LINE_ALLOWED_USER_IDS=
# Optional target OMX/tmux pane id. tradstart normally fills this from the current $TMUX_PANE.
# If you run outside tmux, get it from the agent pane with: tmux display-message -p '#{pane_id}'
LINE_BRIDGE_TMUX_TARGET=
# Local webhook server settings. Public webhook URL will be: https://your-domain.example/line/webhook
LINE_BRIDGE_PORT=8787
LINE_BRIDGE_PATH=/line/webhook
# Optional tuning.
LINE_BRIDGE_COMPLETION_TIMEOUT_MS=600000
LINE_BRIDGE_COMPLETION_POLL_MS=2000
LINE_BRIDGE_TURN_LOG_DIR=.omx/logs
LINE_BRIDGE_CAPTURE_LINES=140
# Codex TUI submit key after tmux paste. Bracketed paste is used for multiline input; Enter submits after paste settles.
LINE_BRIDGE_SUBMIT_KEYS=Enter
LINE_BRIDGE_SUBMIT_DELAY_MS=800
LINE_BRIDGE_CLEAR_BEFORE_SEND=true
LINE_BRIDGE_RESPONSE_DIR=.omx/line-bridge/responses
LINE_BRIDGE_RESPONSE_FILE_CONTRACT=true
LINE_BRIDGE_RESPONSE_RETENTION_DAYS=7
LINE_BRIDGE_RESPONSE_MAX_FILES=200
# Optional text prepended to every LINE prompt before sending it into OMX.
LINE_BRIDGE_COMMAND_PREFIX=

# tradstart startup helper (optional overrides)
TRADE_LINE_TUNNEL_CONFIG=~/.cloudflared/trade-line.yml
TRADE_LINE_TUNNEL_NAME=trade-line
TRADE_LINE_TUNNEL_SESSION=trade-line-cloudflared
TRADE_LINE_TUNNEL_LOG=/tmp/trade-line-cloudflared.log
TRADE_LINE_AGENT_SESSION=trade-line-codex
TRADE_LINE_AGENT_COMMAND=codex
TRADE_LINE_RUNTIME_STATE=.omx/trade-line-runtime.json
TRADE_LINE_PUBLIC_HEALTH_URL=https://line.beautyrxstore.cc/health
LINE_BRIDGE_WEBHOOK_URL=https://line.beautyrxstore.cc/line/webhook
